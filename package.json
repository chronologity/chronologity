{
  "name": "chronologity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.18.0 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint //#lint:root",
    "lint:fix": "turbo run lint:fix //#lint:root:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:integration:clean": "pnpm db:reset && turbo run test:integration",
    "test:watch": "turbo run test:watch",
    "clean": "turbo run clean",
    "lint:root": "eslint eslint.config.js prettier.config.js",
    "lint:root:fix": "eslint eslint.config.js prettier.config.js --fix",
    "infra:up": "bash scripts/infra-up.sh",
    "infra:down": "bash scripts/compose.sh down",
    "infra:reset": "bash scripts/compose.sh down --volumes",
    "infra:ps": "bash scripts/compose.sh ps",
    "infra:logs": "bash scripts/compose.sh logs --follow",
    "infra:validate": "bash scripts/validate-infra.sh",
    "db:reset": "bash scripts/reset-database.sh",
    "load": "node scripts/load.mjs",
    "timeline:scale": "node scripts/timeline-scale.mjs"
  },
  "devDependencies": {
    "@chronologity/eslint-config": "workspace:*",
    "autocannon": "^8.0.0",
    "eslint": "^10.0.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2"
  }
}
