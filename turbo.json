{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", "public/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:unit": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": [
        "NODE_ENV",
        "LOG_LEVEL",
        "POSTGRES_*",
        "KAFKA_*",
        "CLICKHOUSE_*",
        "AUTH_*",
        "SMTP_*",
        "MAILPIT_*"
      ]
    },
    "clean": {
      "cache": false
    },
    "//#lint:root": {
      "inputs": ["eslint.config.js", "prettier.config.js"]
    },
    "//#lint:root:fix": {
      "cache": false
    },
    "test:watch": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    }
  }
}
