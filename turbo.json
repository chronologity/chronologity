{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", "public/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["build", "^build"]
    },
    "test:unit": {
      "dependsOn": ["build", "^build"]
    },
    "test:integration": {
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "//#lint:root": {
      "inputs": ["eslint.config.js", "prettier.config.js"]
    },
    "//#lint:root:fix": {
      "cache": false
    }
  }
}
