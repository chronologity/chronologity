# Dependencies
node_modules/

# Turborepo
.turbo/

# Build outputs
dist/
build/
coverage/
.cache/
public/

# Environment files
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Expo / React Native
.expo/
.expo-shared/
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
*.orig.*

*.key
.metro-health-check*
# Generated by `expo customize` from app.json, and regenerated on demand.
apps/mobile/expo-env.d.ts

# Native build output.
#
# The whole ios/ and android/ directories, not merely their build output:
# Expo generates both from app.json on demand, so a committed copy is a second
# source of truth that drifts from the configuration that produces it.
apps/mobile/ios/
apps/mobile/android/

# Gatsby
.cache/
public/

# TypeScript
*.tsbuildinfo

# Test artifacts
playwright-report/
test-results/

# Editor / IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Claude Code's working directory, which holds session notes and the worktrees
# it creates. Local to whoever is working, and a worktree is a whole checkout
# with a .env in it — so the cost of committing one by accident is a leaked
# secret rather than a tidy-up.
.claude/

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.swp
*.swo
