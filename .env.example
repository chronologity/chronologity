# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3000

# How many requests one client may make in a minute, across every endpoint.
# The global ceiling only: authentication endpoints keep their own tighter
# limits, which this does not relax.
API_RATE_LIMIT_PER_MINUTE=300

# -----------------------------------------------------------------------------
# Feed Aggregator
# -----------------------------------------------------------------------------
FEED_AGGREGATOR_HOST=0.0.0.0
FEED_AGGREGATOR_PORT=4000

# How deep a GraphQL document may nest before it is refused. A read schema with
# reciprocal edges — a Moment naming a Location naming its Moments — can be
# nested into an expensive query by anybody who can send one.
FEED_AGGREGATOR_GRAPHQL_MAX_DEPTH=12

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=chronologity
POSTGRES_USER=chronologity
POSTGRES_PASSWORD=chronologity

# -----------------------------------------------------------------------------
# Kafka
# -----------------------------------------------------------------------------
KAFKA_BROKERS=localhost:9092

# How long a published outbox message is kept before it is swept, in hours.
# The outbox is a queue, not an archive: rows are removed once they are old
# enough that nobody would still be asking whether the event was emitted.
# Abandoned and unpublished messages are never swept.
OUTBOX_RETENTION_HOURS=72

# How long each category of operational residue is kept, in days.
#
# These are the defaults the application uses when the variables are absent;
# they are written out here so that what expires and when is answerable without
# reading the code. Nothing anybody recorded is on this list: no Moment, no
# comment, no media, no moderation record.
RETAIN_SIGN_IN_ARTEFACTS_DAYS=1
RETAIN_READ_NOTIFICATIONS_DAYS=30
RETAIN_NOTIFICATIONS_DAYS=180
RETAIN_REQUIRED_NOTIFICATIONS_DAYS=730
RETAIN_NOTIFICATION_DEDUPLICATION_DAYS=30
RETAIN_DELIVERY_RECORDS_DAYS=30
RETIRE_DORMANT_DEVICES_DAYS=180
RETAIN_RETIRED_DEVICES_DAYS=30
RETAIN_AUDIT_EVENTS_DAYS=730
RETAIN_PRIVACY_REQUESTS_DAYS=90

# -----------------------------------------------------------------------------
# ClickHouse
# -----------------------------------------------------------------------------
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=chronologity
CLICKHOUSE_USERNAME=chronologity
CLICKHOUSE_PASSWORD=chronologity

# Which Timeline projection version this process reads and writes. Leave it
# alone unless you are cutting over: build a second version with
# `pnpm --filter @chronologity/api timeline:rebuild --version <name>`, validate
# it, then set this to that name and redeploy. Erasure always spans every
# version, whatever this says.
TIMELINE_PROJECTION_VERSION=timeline-v1

# Which Search index version is served. `apps/api` owns the constant that names
# it; the feed aggregator only reads it, to ask whether a thing somebody says
# they found is still findable. Cut over the same way: build a second version
# with `pnpm --filter @chronologity/api search:rebuild --version <name>`,
# validate it, then set this and redeploy the API first and the aggregator
# after. Documents for the old version outlive the cutover, so an aggregator
# still naming it gives a stale answer rather than refusing every arrival.
SEARCH_INDEX_VERSION=search-v1

# Where the feed aggregator reports what it observed about itself. Absent means
# it emits nothing, which is what a bare `pnpm dev` and every test want. The
# local collector prints what it receives and forwards nowhere; which backend
# receives this in production is a Phase 16 decision (ADR-046, ADR-149).
FEED_AGGREGATOR_OTLP_ENDPOINT=http://localhost:4318

# How much one GraphQL document may cost, counted in database reads. Depth bounds
# how far down a document reaches; this bounds how much it asks for. The weights
# come from what Phase 9I measured (ADR-150). Raise it for a measurement harness,
# never for a client.
FEED_AGGREGATOR_GRAPHQL_MAX_COST=100

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# SECRET. Generate with: openssl rand -base64 48
AUTH_JWT_SECRET=local-development-only-replace-with-a-generated-value
AUTH_JWT_ISSUER=chronologity
AUTH_JWT_AUDIENCE=chronologity-clients
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_MAGIC_LINK_TTL_SECONDS=900

# How long a sign-in code sent by text lasts, in seconds.
# Much shorter than a magic link: a link carries 32 random bytes and cannot be
# guessed, while a six-digit code can, so the window it is guessable in stays
# small.
AUTH_PHONE_CODE_TTL_SECONDS=300

# Where a magic link points. The API issues the link; the client consumes it.
AUTH_MAGIC_LINK_BASE_URL=http://localhost:3000/auth/sessions

# -----------------------------------------------------------------------------
# Object storage
# Local development uses SeaweedFS in S3 mode. The credentials below are local
# development values that match docker/seaweedfs/s3.json; production storage is
# a later decision and will supply its own.
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://127.0.0.1:8333
S3_PORT=8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=chronologity
S3_SECRET_ACCESS_KEY=chronologity-local-secret
S3_BUCKET=chronologity-media
# SeaweedFS and most S3-compatible servers address buckets by path rather than
# by subdomain. AWS itself does not, which is why this is configuration.
S3_FORCE_PATH_STYLE=true

# How long a presigned upload URL remains usable. Short by intent: it authorises
# a write, and a long-lived write authorisation is a long-lived liability.
S3_UPLOAD_URL_TTL_SECONDS=900
# How long a registered upload may remain unfinalized before it is refused.
UPLOAD_REGISTRATION_TTL_SECONDS=3600
# Per-file technical limits (`media.md:266`), not per-Moment media counts.
UPLOAD_MAX_IMAGE_BYTES=26214400
UPLOAD_MAX_VIDEO_BYTES=524288000

# -----------------------------------------------------------------------------
# Users
# -----------------------------------------------------------------------------
# The minimum age for creating an account, in whole years. Configuration rather
# than a constant because it is a legal question and the answer differs by
# jurisdiction: thirteen matches COPPA, while the European Union sets sixteen
# and lets member states lower it to thirteen.
USER_MINIMUM_AGE_YEARS=13

# -----------------------------------------------------------------------------
# Email
# Local development uses Mailpit. Production delivery is a later decision.
# -----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@chronologity.local
MAILPIT_UI_PORT=8025

# Argon2id cost (OWASP floor) and password policy.
AUTH_PASSWORD_MEMORY_COST_KIB=19456
AUTH_PASSWORD_TIME_COST=2
AUTH_PASSWORD_PARALLELISM=1
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_MAX_LENGTH=256
