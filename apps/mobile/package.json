{
  "name": "@chronologity/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Chronologity's React Native consumer application.",
  "license": "UNLICENSED",
  "main": "index.ts",
  "scripts": {
    "build": "expo export --platform ios --platform android --output-dir dist",
    "clean": "rm -rf dist .expo tsconfig.tsbuildinfo",
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:unit": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chronologity/api-client": "workspace:*",
    "@chronologity/config": "workspace:*",
    "@chronologity/contracts": "workspace:*",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~57.0.20",
    "expo-crypto": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-url-polyfill": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chronologity/tsconfig": "workspace:*",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "^7.0.2"
  }
}
