# Variables read by apps/api.
#
# The repository root .env is the single file used in local development; this
# lists what this application requires from it. Values here are local defaults
# only. Deployed environments supply their own, from a secret manager rather
# than from a file.

NODE_ENV=development
LOG_LEVEL=debug

API_HOST=0.0.0.0
API_PORT=3000

# No default: a missing database target must stop the process rather than
# silently point it somewhere plausible.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=chronologity
POSTGRES_USER=chronologity
POSTGRES_PASSWORD=chronologity

EVENTSTOREDB_URL=esdb://localhost:2113?tls=false

KAFKA_BROKERS=localhost:9092
