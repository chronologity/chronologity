{
  "name": "@chronologity/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Chronologity's authoritative backend application.",
  "license": "UNLICENSED",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "dev": "node --watch dist/main.js",
    "grant-role": "node dist/cli/grant-role.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate": "node dist/cli/migrate.js",
    "start": "node dist/main.js",
    "start:publisher": "node dist/workers/event-publisher/index.js",
    "start:outbox-publisher": "node dist/workers/outbox-publisher/index.js",
    "start:media": "node dist/workers/media/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@chronologity/config": "workspace:*",
    "@chronologity/contracts": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.1.0",
    "fastify": "^5.12.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.8",
    "kafkajs": "^2.2.4",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chronologity/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
