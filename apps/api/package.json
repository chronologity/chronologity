{
  "name": "@chronologity/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Chronologity's authoritative backend application.",
  "license": "UNLICENSED",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "dev": "node --watch dist/main.js",
    "grant-role": "node dist/cli/grant-role.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate": "node dist/cli/migrate.js",
    "search:rebuild": "node dist/cli/rebuild-search-index.js",
    "spec:check": "node dist/cli/generate-spec.js && git diff --exit-code -- openapi.json",
    "spec:generate": "node dist/cli/generate-spec.js",
    "start": "node dist/main.js",
    "start:media": "node dist/workers/media/index.js",
    "start:notification-generator": "node dist/workers/notification-generator/index.js",
    "start:outbox-publisher": "node dist/workers/outbox-publisher/index.js",
    "start:search-indexer": "node dist/workers/search-indexer/index.js",
    "start:significance": "node dist/workers/significance/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@chronologity/config": "workspace:*",
    "@chronologity/contracts": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@node-rs/argon2": "^2.1.0",
    "exif-reader": "2.0.3",
    "fastify": "^5.12.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.8",
    "kafkajs": "^2.2.4",
    "libphonenumber-js": "^1.13.11",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chronologity/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
