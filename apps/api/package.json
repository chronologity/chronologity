{
  "name": "@chronologity/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Chronologity's authoritative backend application.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "dev": "node --watch dist/index.js",
    "grant-role": "node dist/cli/grant-role.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate": "node dist/cli/migrate.js",
    "start": "node dist/index.js",
    "start:publisher": "node dist/workers/event-publisher/index.js",
    "test": "node --test \"dist/**/*.test.js\"",
    "test:integration": "node --test \"dist/**/*.integration.js\"",
    "test:unit": "node --test \"dist/**/*.test.js\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chronologity/config": "workspace:*",
    "@chronologity/contracts": "workspace:*",
    "@eventstore/db-client": "^6.2.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.1.0",
    "fastify": "^5.12.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.8",
    "kafkajs": "^2.2.4",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chronologity/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "typescript": "^7.0.2"
  }
}
