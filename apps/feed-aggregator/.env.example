# Variables read by apps/feed-aggregator.
#
# The repository root .env is the single file used in local development; this
# lists what this application requires from it. Values here are local defaults
# only. Deployed environments supply their own, from a secret manager rather
# than from a file.

NODE_ENV=development
LOG_LEVEL=debug

FEED_AGGREGATOR_HOST=0.0.0.0
FEED_AGGREGATOR_PORT=4000

# How deep a GraphQL document may nest before it is refused. A read schema with
# reciprocal edges — a Moment naming a Location naming its Moments — can be
# nested into an expensive query by anybody who can send one, so the bound is
# configuration rather than a constant.
FEED_AGGREGATOR_GRAPHQL_MAX_DEPTH=12

# -----------------------------------------------------------------------------
# ClickHouse
# Where the Timeline read models live. This application's primary store.
# -----------------------------------------------------------------------------
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=chronologity
CLICKHOUSE_USERNAME=chronologity
CLICKHOUSE_PASSWORD=chronologity

# Which Timeline projection version this process reads. It must name the version
# the API is maintaining, or this service reads history nobody is updating.
TIMELINE_PROJECTION_VERSION=timeline-v1

# -----------------------------------------------------------------------------
# PostgreSQL
# Read-only, and narrow by intent, though narrower in what it may do than in
# what it asks. This application asks whether a Session still authenticates,
# what a Viewer is entitled to see, and — when somebody opens a Moment — what
# that Moment says. The last is the only read of authoritative state, and it
# happens on a tap rather than while scrolling: history is paged from ClickHouse.
# It holds no domain-write credential and owns no schema. A deployment should
# issue it a role that can SELECT and nothing more.
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=chronologity
POSTGRES_USER=chronologity
POSTGRES_PASSWORD=chronologity

# -----------------------------------------------------------------------------
# Authentication
# Verification only. This application issues no token and creates no Session;
# the API owns both. These must match what the API signs with, or every
# authenticated read is refused.
# -----------------------------------------------------------------------------
AUTH_JWT_SECRET=local-development-only-replace-with-a-generated-value
AUTH_JWT_ISSUER=chronologity
AUTH_JWT_AUDIENCE=chronologity-clients
