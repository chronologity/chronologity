{
  "name": "@chronologity/feed-aggregator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Chronologity's read-only GraphQL Timeline composition service.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --build tsconfig.build.json && node scripts/copy-schema.mjs",
    "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "dev": "node --watch dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "measure": "node scripts/measure-reads.mjs"
  },
  "dependencies": {
    "@chronologity/config": "workspace:*",
    "@chronologity/contracts": "workspace:*",
    "@chronologity/moment-access": "workspace:*",
    "@chronologity/timeline-derivation": "workspace:*",
    "@clickhouse/client": "^1.23.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "dataloader": "^2.2.3",
    "fastify": "^5.12.0",
    "fastify-plugin": "^6.0.0",
    "graphql": "16.14.2",
    "jose": "^6.2.8",
    "mercurius": "^16.10.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chronologity/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
