{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Chronologity Base",
  "_comment": [
    "Runtime-neutral strictness shared by every Chronologity package and application.",
    "Target, lib, module resolution, and JSX belong in per-runtime presets, which are",
    "added when a real Node, React Native, or browser consumer exists."
  ],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true
  }
}
