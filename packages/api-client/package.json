{
  "name": "@chronologity/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed REST client for the Chronologity API.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"dist/**/*.test.js\"",
    "test:unit": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@chronologity/contracts": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chronologity/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
